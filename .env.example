RESEND_SEND=re_your_resend_api_key
RESEND_FROM=WEB | jandrly.cz <web@jandrly.cz>
# Recipient of contact form messages. Defaults to the site owner's address when empty.
RESEND_TO=

# Public widget key. Set during the Vite production build.
# Local development: Cloudflare test sitekey 1x00000000000000000000AA (always passes).
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Private key. Never expose this as a VITE_ variable.
# Local development: Cloudflare test secret 1x0000000000000000000000000000000AA
# (accepted only when NODE_ENV !== 'production').
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# HMAC secret for the signed contact form token (required). Generate with:
#   openssl rand -hex 32
FORM_TOKEN_SECRET=

# Comma-separated hostnames Turnstile must report for a valid token.
# Defaults to "jandrly.cz,www.jandrly.cz"; localhost is added automatically outside production.
# Add preview hostnames here if the form should work on Vercel preview deployments.
CONTACT_ALLOWED_HOSTNAMES=jandrly.cz,www.jandrly.cz

# Optional: shared rate limiting via Upstash Redis (3/h per IP, 2/day per email address).
# Without these, a best-effort in-memory limiter is used (per serverless instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# When true, the contact form logs a redacted summary instead of sending email.
# For local testing only; never enable in production.
CONTACT_DRY_RUN=false

# Search engine ownership verification (optional). These tokens are public by design: they are rendered as
# <meta> tags on the homepage of both locales (only the ones that are set). Set during the Vite production build.
# Google Search Console, HTML tag method: the `content` value of <meta name="google-site-verification">.
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools, HTML meta tag method: the `content` value of <meta name="msvalidate.01">.
VITE_BING_SITE_VERIFICATION=
# Seznam Webmaster, meta tag method: the `content` value of <meta name="seznam-wmt">.
VITE_SEZNAM_SITE_VERIFICATION=
